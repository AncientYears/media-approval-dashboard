[Unit]
Description=Media Approval Dashboard
Documentation=https://github.com/AncientYears/media-approval-dashboard
After=network-online.target
Wants=network-online.target
# The app hardlinks between /media/Torrents and /media/{Filmy,Serialy}. If the
# NFS mount is not up, those hardlinks silently fall back to full copies and
# triple disk usage, so never start before the mount is ready.
RequiresMountsFor=/media

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_USER@@
WorkingDirectory=@@APP_DIR@@
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/server.js

Restart=on-failure
RestartSec=5
# server.ts handles SIGTERM and closes the SQLite handle on the way out.
KillSignal=SIGTERM
TimeoutStopSec=20

# Light hardening only. Deliberately not ProtectSystem/ReadWritePaths: the app
# writes to the NFS export at /media, which those options interact badly with.
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=media-approval-app

[Install]
WantedBy=multi-user.target
