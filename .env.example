# ============================================================
# Storage layout
# ============================================================
# Canonical root for all media paths. Everything below derives
# from this unless explicitly overridden. Must be absolute.
#
# The app and qBittorrent must mount the shared storage at this
# SAME path. Hardlinks are created server-side and work across
# VMs on one NFS export, but if the two disagree on the path the
# app needs QBIT_PATH_PREFIX to translate (see below).
MEDIA_ROOT=/media

# Optional: only needed when qBittorrent's view of the storage differs
# from the app's. Leave BOTH empty (recommended) when both processes
# mount the storage at the same absolute path — the path conversions
# are then no-ops.
# Legacy containerised setup: app sees /media/Torrents, qBittorrent
# container sees the same directory as /Torrents.
# QBIT_PATH_PREFIX=/Torrents
# QBIT_HOST_PREFIX=/media/Torrents

# Per-directory overrides. Defaults shown.
# DOWNLOADS_MOVIES=/media/Torrents/download/filmy
# DOWNLOADS_TV=/media/Torrents/download/serialy
# PROCESSED_MOVIES=/media/Torrents/processed/filmy
# PROCESSED_TV=/media/Torrents/processed/serialy
# PROCESSING_WORKSPACE=/media/Torrents/Workspace
# TRACKERS_DIR=/media/Torrents/Trackers
# MEDIA_MOVIES=/media/Filmy
# MEDIA_TV=/media/Serialy

# ============================================================
# Prowlarr (search indexers directly)
# ============================================================
PROWLARR_URL=
PROWLARR_API_KEY=

# ============================================================
# Radarr / Sonarr (metadata, episode model, library import)
# ============================================================
# When PROWLARR_API_KEY is set, search goes to Prowlarr and grabs
# go straight to qBittorrent via magnet. The Arr search/import
# endpoints are only the fallback.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# ============================================================
# qBittorrent (download)
# ============================================================
QBIT_URL=http://127.0.0.1:8080
QBIT_USER=
QBIT_PASS=

# ============================================================
# Polling (seconds)
# ============================================================
POLL_INTERVAL_RADARR=60
POLL_INTERVAL_SONARR=60
POLL_INTERVAL_STATUS=30

# ============================================================
# Notifications
# ============================================================
NTFY_URL=
NTFY_TOPIC=
